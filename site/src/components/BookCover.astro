---
// A book facing out. The cloth cover with its foil title is always there;
// cover art, when we have it, sits on top and falls away if it fails to load.
const { title, author = "", coverUrl = null, look, class: className = "", ...rest } = Astro.props;
---
<span class:list={["book-cover", className]} style={look.style} aria-hidden="true" {...rest}>
  <span class="cover-art">
    <span class="cover-title" data-cover-title>{title}</span>
    <span class="cover-author" data-cover-author>{author}</span>
  </span>
  {coverUrl ? <img src={coverUrl} alt="" loading="lazy" decoding="async" /> : null}
  <span class="cover-ribbon"></span>
  <span class="cover-seal"></span>
</span>
