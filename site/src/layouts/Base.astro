---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "@fontsource/courier-prime/latin-400.css";
import "@fontsource/courier-prime/latin-ext-400.css";
import "../styles/library.css";
const {
  title = "Literature Courses",
  showAuth = true,
  showNav = true,
  authRequired = false,
  loginPage = false,
  courseSwitcher = null,
  bookSwitcher = null,
  showSourcePills: showSourcePillsProp = null
} = Astro.props;

const showSourcePills =
  typeof showSourcePillsProp === "boolean"
    ? showSourcePillsProp
    : import.meta.env.PUBLIC_SHOW_SOURCE_PILLS === "true";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2c4437" />
    <script>
      window.__SUPABASE__ = {
        url: import.meta.env.PUBLIC_SUPABASE_URL,
        key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      };
    </script>
    <title>{title}</title>
  </head>
  <body
    data-auth-required={authRequired ? "true" : "false"}
    data-login-page={loginPage ? "true" : "false"}
    data-show-sources={showSourcePills ? "true" : "false"}
  >
    {showNav ? (
      <header class="mast">
        <div class="mast-inner">
          <a class="wordmark" href="/">Literature Course Library</a>
          <div class="nav-links">
            <a href="/">Courses</a>
            <a class="nav-tool" href="/docs">Docs</a>
            <a class="nav-tool" href="/deploy">Deploy</a>
          </div>
          {(courseSwitcher || bookSwitcher) ? (
            <div class="nav-actions">
              {courseSwitcher ? (
                <details
                  class="course-switcher"
                  data-course-switcher
                  data-current-course-id={courseSwitcher.current.id ?? ""}
                  data-current-course-slug={courseSwitcher.current.slug ?? ""}
                  data-current-course-source={courseSwitcher.current.source ?? "system"}
                >
                  <summary>
                    <span class="course-switcher-label">Course</span>
                    <span class="course-switcher-title" data-course-switcher-title>
                      {courseSwitcher.current.title}
                    </span>
                    <span class="caret" aria-hidden="true"></span>
                  </summary>
                  <div class="course-switcher-menu" data-course-switcher-menu>
                    {courseSwitcher.courses.map((course) => {
                      const [mainTitle, ...restTitle] = course.title.split(" - ");
                      const subtitle = restTitle.join(" - ");
                      return (
                        <a
                          class={`course-switcher-item${course.slug === courseSwitcher.current.slug ? " is-active" : ""}`}
                          href={`/course/${course.slug}`}
                        >
                          <div class="course-switcher-item-title">{mainTitle}</div>
                          {subtitle ? (
                            <div class="course-switcher-item-sub">{subtitle}</div>
                          ) : null}
                        </a>
                      );
                    })}
                  </div>
                </details>
              ) : null}

              {bookSwitcher ? (
                <details
                  class="course-switcher"
                  data-book-switcher
                  data-current-book-id={bookSwitcher.current.id ?? ""}
                  data-current-course-id={bookSwitcher.current.courseId ?? ""}
                  data-current-course-source={courseSwitcher?.current.source ?? "system"}
                >
                  <summary>
                    <span class="course-switcher-label">Book</span>
                    <span class="course-switcher-title" data-book-switcher-title>
                      {bookSwitcher.current.title}
                    </span>
                    <span class="caret" aria-hidden="true"></span>
                  </summary>
                  <div class="course-switcher-menu" data-book-switcher-menu>
                    {bookSwitcher.books.map((book) => (
                      <a
                        class={`course-switcher-item${book.slug === bookSwitcher.current.slug ? " is-active" : ""}`}
                        href={`/book/${book.slug}`}
                      >
                        <div class="course-switcher-item-title">{book.title}</div>
                        <div class="course-switcher-item-sub">{book.id}</div>
                      </a>
                    ))}
                  </div>
                </details>
              ) : null}
            </div>
          ) : null}
          {showAuth ? (
            <div class="auth-nav">
              <a href="/login" data-auth-login>Login</a>
              <a href="/login" data-auth-logout hidden>Sign out</a>
            </div>
          ) : null}
        </div>
      </header>
    ) : null}

    <div class="page">
      <slot />

    </div>
    {loginPage ? null : (
      <footer class="colophon">
        <div class="colophon-inner">
          <span><strong>Literature Course Library</strong></span>
          <span>A private shelf for a structured canon.</span>
          <span class="colophon-tools">
            <a href="/docs">Docs</a>
            <a href="/deploy">Deploy</a>
          </span>
        </div>
      </footer>
    )}
    {authRequired ? <script type="module" src="/scripts/auth-guard.js"></script> : null}
    {showAuth ? <script type="module" src="/scripts/nav-auth.js"></script> : null}
    {loginPage ? <script type="module" src="/scripts/login-redirect.js"></script> : null}
    <script type="module" src="/scripts/course-switcher-user.js"></script>
    <script type="module" src="/scripts/strip-heading-icons.js"></script>
    <script type="module" src="/scripts/cover-fallback.js"></script>
    <script type="module" src="/scripts/shelf.js"></script>
  </body>
</html>
