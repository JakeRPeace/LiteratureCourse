---
import AuthPanel from "../components/AuthPanel.astro";
const { title = "Literature Courses" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/geist-font@1.2.0/style.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: light;
        font-family: "Geist", "Geist Sans", "Space Grotesk", system-ui, sans-serif;
        background-color: #fafafa;
        color: #111111;
        --ink: #111111;
        --muted: #666666;
        --accent: #111111;
        --accent-2: #0a0a0a;
        --surface: #ffffff;
        --line: #eaeaea;
        --shadow: rgba(0, 0, 0, 0.08);
        --glow: rgba(0, 0, 0, 0.12);
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 20% 10%, rgba(0, 0, 0, 0.06), transparent 45%),
          radial-gradient(circle at 70% 0%, rgba(0, 0, 0, 0.1), transparent 50%),
          linear-gradient(to right, rgba(0, 0, 0, 0.06) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(0, 0, 0, 0.06) 1px, transparent 1px),
          #fafafa;
        background-size: 56px 56px;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 24px 96px;
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 32px;
      }

      .nav a {
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .hero {
        position: relative;
        overflow: hidden;
        border-radius: 18px;
        border: 1px solid var(--line);
        background: var(--surface);
        box-shadow: 0 14px 32px var(--shadow);
        padding: 24px;
        margin-bottom: 32px;
      }

      .hero::after {
        content: "";
        position: absolute;
        inset: -60% -30% auto auto;
        width: 320px;
        height: 320px;
        background: radial-gradient(circle, var(--glow), transparent 65%);
        pointer-events: none;
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: auto auto -120px -120px;
        width: 280px;
        height: 280px;
        background: radial-gradient(circle, rgba(0, 0, 0, 0.16), transparent 70%);
        opacity: 0.6;
        pointer-events: none;
      }

      .hero-stack {
        position: absolute;
        inset: 16px 16px auto auto;
        width: 180px;
        height: 120px;
        border-radius: 18px;
        background: linear-gradient(135deg, rgba(0, 0, 0, 0.1), transparent 60%);
        border: 1px solid rgba(0, 0, 0, 0.06);
        transform: rotate(-6deg);
        pointer-events: none;
      }

      .hero-stack::after {
        content: "";
        position: absolute;
        inset: 12px;
        border-radius: 14px;
        border: 1px solid rgba(0, 0, 0, 0.06);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.8), transparent);
      }

      .brand {
        background: var(--surface);
        padding: 20px 24px;
        border-radius: 14px;
        border: 1px solid var(--line);
        box-shadow: 0 10px 24px var(--shadow);
      }

      .brand h1 {
        margin: 0 0 8px;
        font-size: 26px;
        letter-spacing: -0.02em;
      }

      .brand p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
      }

      .card {
        background: var(--surface);
        border-radius: 14px;
        padding: 20px 24px;
        border: 1px solid var(--line);
        box-shadow: 0 8px 20px var(--shadow);
      }

      .stack {
        display: grid;
        gap: 20px;
      }

      .grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 999px;
        background: #f2f2f2;
        color: #111111;
        font-size: 12px;
        font-weight: 600;
      }

      .pill-link {
        background: white;
        border: 1px solid var(--line);
        color: #111111;
      }

      .section-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
      }

      .section-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
      }

      .section-cta span {
        transition: transform 0.2s ease;
      }

      .section-cta:hover span {
        transform: translateX(3px);
      }

      .auth-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        padding: 16px;
        border-radius: 14px;
        min-width: 220px;
        box-shadow: 0 8px 20px var(--shadow);
      }

      .auth-title {
        font-weight: 600;
        margin-bottom: 10px;
      }

      .auth-field {
        display: grid;
        gap: 6px;
        font-size: 12px;
        margin-bottom: 10px;
        color: var(--muted);
      }

      .auth-field input {
        padding: 8px 10px;
        border-radius: 10px;
        border: 1px solid var(--line);
        font-family: inherit;
      }

      .auth-actions {
        display: flex;
        gap: 8px;
      }

      button {
        font-family: inherit;
        background: #111111;
        color: white;
        border: 1px solid #111111;
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      button:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
      }

      button[data-auth-action="signup"] {
        background: white;
        color: #111111;
        border: 1px solid var(--line);
      }

      button[data-auth-action="signout"] {
        background: #111111;
        color: white;
        border: 1px solid #111111;
      }

      .auth-error {
        color: #b1281f;
        font-size: 12px;
        min-height: 16px;
      }

      .auth-user {
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 10px;
        word-break: break-all;
      }

      .section-title {
        font-size: 20px;
        margin-bottom: 6px;
        letter-spacing: -0.01em;
      }

      .section-subtitle {
        color: var(--muted);
        margin: 0 0 16px;
      }

      .link-card {
        display: grid;
        gap: 8px;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 16px;
        background: white;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .link-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 24px var(--shadow);
      }

      .link-card h3 {
        margin: 0;
        font-size: 18px;
      }

      .link-card p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
      }

      .guide-content :global(h2) {
        margin-top: 24px;
      }

      .guide-content :global(h3) {
        margin-top: 18px;
      }

      @media (max-width: 720px) {
        .nav {
          flex-direction: column;
        }

        .auth-panel {
          width: 100%;
        }

        .nav-links {
          justify-content: center;
        }
      }

      footer {
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 13px;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <div class="nav-links">
          <a href="/">Courses</a>
          <a href="/docs" class="pill pill-link">Docs</a>
          <a href="/deploy" class="pill pill-link">Deploy</a>
        </div>
        <AuthPanel />
      </header>

      <section class="hero">
        <div class="hero-stack" aria-hidden="true"></div>
        <div class="brand">
          <h1>Literature Course Library</h1>
          <p>Your reading stack, structured and searchable with progress tracking.</p>
        </div>
      </section>

      <slot />

      <footer>
        <span>Literature Course Library</span>
        <span>Built with Astro + Supabase</span>
      </footer>
    </div>
  </body>
</html>
