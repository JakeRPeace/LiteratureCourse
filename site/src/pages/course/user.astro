---
import Base from "../../layouts/Base.astro";
import { getCourses } from "../../lib/content.js";
import { loadSystemCourses } from "../../lib/system-content.js";

const systemCourses = await loadSystemCourses();
const courses = systemCourses ?? getCourses();

const courseSwitcher = {
  current: {
    title: "Loading course...",
    id: "",
    slug: "",
    source: "user"
  },
  courses
};
---
<Base
  title="Course | Literature Course Library"
  authRequired={true}
  courseSwitcher={courseSwitcher}
>
  <section class="stack" data-user-course>
    <header class="page-head">
      <a class="back-link" href="/">Back to the shelves</a>
      <p class="eyebrow">Your course</p>
      <h1 class="section-title page-title" data-user-course-title>Loading course...</h1>
      <p class="section-subtitle" data-user-course-id></p>
      <span class="data-source-pill">User</span>
    </header>

    <div class="card" data-user-course-error hidden>
      <p></p>
    </div>

    <div class="section-header">
      <div>
        <h2 class="section-title">Course Materials</h2>
        <p class="section-subtitle">Scan the overview and syllabus before diving in.</p>
      </div>
    </div>

    <div class="course-doc-grid" data-user-course-docs></div>
    <div class="card" data-user-course-docs-empty hidden>
      <p>No course documents are available yet.</p>
    </div>

    <div class="section-header">
      <div>
        <h2 class="section-title">Books</h2>
        <p class="section-subtitle">In reading order. Take one down to open its guides.</p>
      </div>
    </div>
    <div class="ledge-wall" data-user-course-books></div>
    <div class="card" data-user-course-books-empty hidden>
      <p>No books are available yet.</p>
    </div>
  </section>
  <script type="module" src="/scripts/user-course-page.js"></script>
  <script type="module" src="/scripts/course-book-status.js"></script>
</Base>
