<div class="auth-panel" data-auth>
  <div class="auth-state" data-auth-state="signed-out">
    <div class="auth-title">Account</div>
    <div class="auth-error" data-auth-error></div>
    <label class="auth-field">
      <span>Email</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <label class="auth-field">
      <span>Password</span>
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <div class="auth-actions">
      <button type="button" data-auth-action="signin">Sign in</button>
      <button type="button" data-auth-action="signup">Sign up</button>
    </div>
  </div>
  <div class="auth-state" data-auth-state="signed-in" hidden>
    <div class="auth-title">Signed in</div>
    <div class="auth-user" data-auth-user></div>
    <button type="button" data-auth-action="signout">Sign out</button>
  </div>
</div>

<script type="module" src={Astro.resolve("../scripts/auth.js")}></script>
