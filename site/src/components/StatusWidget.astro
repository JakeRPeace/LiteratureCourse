---
const { bookId, initialStatus = "not_started", initialScore = "" } = Astro.props;
---
<div class="card" data-book-status data-book-id={bookId}>
  <div class="section-title">Your status</div>
  <p class="section-subtitle">Track reading progress and add a score once finished.</p>
  <div class="status-grid">
    <label>
      <span>Status</span>
      <select data-status>
        <option value="not_started">Not started</option>
        <option value="in_progress">In progress</option>
        <option value="read">Read</option>
      </select>
    </label>
    <label>
      <span>Score</span>
      <input
        type="number"
        min="1"
        max="5"
        step="0.25"
        placeholder="1-5"
        data-score
      />
    </label>
  </div>
  <div class="status-note" data-note></div>
</div>

<script type="module" src={new URL("../scripts/book-status.js", import.meta.url).href}></script>

<style>
  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
  }

  label {
    display: grid;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
  }

  select,
  input {
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid var(--line);
    font-family: inherit;
  }

  .status-note {
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
    min-height: 16px;
  }
</style>
