---
import Base from "../../../layouts/Base.astro";
import { getCourses, getBookBySlug } from "../../../lib/content.js";
import {
  loadSystemBookBySlug,
  loadSystemBookGuide,
  loadSystemBookGuidesIndex
} from "../../../lib/system-content.js";
import { resolveSourceLabel } from "../../../lib/source-labels.js";
import { renderMarkdownSafe } from "../../../lib/markdown.js";

export const prerender = true;

export async function getStaticPaths() {
  const systemGuidesIndex = await loadSystemBookGuidesIndex();
  if (systemGuidesIndex) {
    return systemGuidesIndex.map((entry) => ({
      params: { slug: entry.bookSlug, guide: entry.guideSlug }
    }));
  }

  const books = getCourses().flatMap((course) => course.books);
  return books.flatMap((book) =>
    book.guides.map((guide) => ({
      params: { slug: book.slug, guide: guide.slug }
    }))
  );
}

const { slug, guide: guideSlug } = Astro.params;
const systemBook = await loadSystemBookBySlug(slug);
const markdownBook = getBookBySlug(slug);
const book = systemBook ?? markdownBook;
if (!book) {
  throw new Error(`Book not found: ${slug}`);
}

const guideEntry =
  markdownBook?.guides.find((guide) => guide.slug === guideSlug) || null;

const systemGuide = await loadSystemBookGuide(book.id, guideSlug);
if (!systemGuide && !guideEntry) {
  throw new Error(`Guide not found: ${guideSlug}`);
}

const guideModule = systemGuide ? null : guideEntry?.module;
const guideSource = systemGuide ? "supabase" : "markdown";
const guideSourceLabel = resolveSourceLabel(guideSource);
const guideLabel = systemGuide?.label || guideEntry?.label || "Guide";
const guideHtml = systemGuide ? renderMarkdownSafe(systemGuide.content) : null;
---
<Base title={`${guideLabel} | ${book.title} | Literature Course Library`} authRequired={true}>
  <section class="stack">
    <div class="page-head">
      <a class="back-link" href={`/book/${book.slug}`}>Back to the book</a>
      <span class="data-source-pill">{guideSourceLabel}</span>
    </div>

    {guideHtml ? (
      <div class="reading guide-content" set:html={guideHtml} />
    ) : guideModule ? (
      <div class="reading guide-content">
        <guideModule.Content />
      </div>
    ) : (
      <div class="card">
        <p>Guide content is unavailable.</p>
      </div>
    )}
  </section>
</Base>
