---
import Base from "../../../layouts/Base.astro";
import { getCourses } from "../../../lib/content.js";
import { loadSystemCourses } from "../../../lib/system-content.js";

const systemCourses = await loadSystemCourses();
const courses = systemCourses ?? getCourses();

const courseSwitcher = {
  current: {
    title: "Loading course...",
    id: "",
    slug: "",
    source: "user"
  },
  courses
};
---
<Base
  title="Course Doc | Literature Course Library"
  authRequired={true}
  courseSwitcher={courseSwitcher}
>
  <section class="stack" data-user-course-doc>
    <div class="page-head">
      <a class="back-link" href="/" data-user-course-doc-back>Back to course</a>
      <h1 class="section-title page-title" data-user-course-doc-title>Loading document...</h1>
      <span class="data-source-pill">User</span>
    </div>

    <div class="reading guide-content" data-user-course-doc-content></div>
    <div class="card" data-user-course-doc-error hidden>
      <p></p>
    </div>
  </section>
  <script type="module" src="/scripts/user-course-doc.js"></script>
</Base>
