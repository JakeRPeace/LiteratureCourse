---
import Base from "../../layouts/Base.astro";
import StatusWidget from "../../components/StatusWidget.astro";
import { getCourses, getBookBySlug } from "../../lib/content.js";

export function getStaticPaths() {
  const books = getCourses().flatMap((course) => course.books);
  return books.map((book) => ({
    params: { slug: book.slug }
  }));
}

const { slug } = Astro.params;
const book = getBookBySlug(slug);
if (!book) {
  throw new Error(`Book not found: ${slug}`);
}

const guideModules = book.guides
  .map((guide) => guide.module)
  .filter(Boolean);
---
<Base title={`${book.title} | Literature Course Library`} authRequired={true}>
  <section class="stack">
    <div class="book-hero">
      <div class={`book-cover ${book.coverUrl ? "" : "is-empty"}`}>
        {book.coverUrl ? (
          <img
            src={book.coverUrl}
            alt={`Cover of ${book.title}`}
            loading="lazy"
            decoding="async"
          />
        ) : null}
      </div>
      <div class="book-intro">
        <a class="pill" href={`/course/${book.courseSlug}`}>Back to course</a>
        <h2 class="section-title">{book.title}</h2>
        <p class="section-subtitle">
          {book.author ? `${book.author} · ` : ""}{book.id}
        </p>
      </div>
    </div>

    <div class="section-divider"></div>

    <StatusWidget bookId={book.id} />

    {guideModules.map((guide, index) => (
      <div class="card guide-content" key={index}>
        <guide.Content />
      </div>
    ))}
  </section>
</Base>

<style>
  .book-hero {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: 24px;
    align-items: center;
  }

  .book-intro {
    display: grid;
    gap: 10px;
  }

  .book-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.6);
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book-cover.is-empty::after {
    content: "";
    position: absolute;
    inset: 12px;
    border-radius: 12px;
    border: 1px dashed rgba(255, 255, 255, 0.2);
  }

  @media (max-width: 720px) {
    .book-hero {
      grid-template-columns: 1fr;
    }

    .book-cover {
      max-width: 220px;
    }
  }
</style>
