---
import AuthPanel from "../components/AuthPanel.astro";
const { title = "Literature Courses" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/geist-font@1.2.0/style.css"
    />
    <style>
      * {
        box-sizing: border-box;
      }

      :root {
        color-scheme: dark;
        font-family: "Geist", "Geist Sans", system-ui, sans-serif;
        background-color: #000000;
        color: #f7f7f7;
        --ink: #f7f7f7;
        --muted: #9b9b9b;
        --accent: #f7f7f7;
        --accent-2: #b3b3b3;
        --surface: #0a0a0a;
        --line: #1f1f1f;
        --shadow: rgba(0, 0, 0, 0.6);
        --glow: rgba(120, 120, 120, 0.24);
        --glow-2: rgba(74, 124, 255, 0.2);
        --heading-72: 4.5rem;
        --heading-56: 3.5rem;
        --heading-40: 2.5rem;
        --copy-18: 1.125rem;
        --copy-16: 1rem;
        --copy-14: 0.875rem;
        --radius-lg: 18px;
        --radius-md: 12px;
        --radius-sm: 10px;
      }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at 10% 0%, rgba(74, 124, 255, 0.18), transparent 45%),
          radial-gradient(circle at 80% -10%, rgba(132, 76, 255, 0.2), transparent 50%),
          linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
          #000000;
        background-size: 64px 64px;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 32px 24px 88px;
      }

      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
      }

      .nav a {
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.01em;
      }

      .nav a:hover {
        color: #f7f7f7;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 18px;
      }

      .hero {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: linear-gradient(135deg, rgba(20, 20, 20, 0.9), rgba(5, 5, 5, 0.9));
        box-shadow:
          0 28px 60px rgba(0, 0, 0, 0.65),
          0 0 0 1px rgba(255, 255, 255, 0.04) inset;
        padding: 24px;
        margin-bottom: 28px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 24px;
        align-items: center;
      }

      .hero::after {
        content: "";
        position: absolute;
        inset: -40% -20% auto auto;
        width: 360px;
        height: 360px;
        background: radial-gradient(circle, var(--glow-2), transparent 65%);
        pointer-events: none;
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: auto auto -120px -120px;
        width: 280px;
        height: 280px;
        background: radial-gradient(circle, var(--glow), transparent 70%);
        opacity: 0.85;
        pointer-events: none;
      }

      .hero-stack {
        position: absolute;
        inset: 16px 16px auto auto;
        width: 180px;
        height: 120px;
        border-radius: var(--radius-lg);
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), transparent 60%);
        border: 1px solid rgba(255, 255, 255, 0.08);
        transform: rotate(-6deg);
        pointer-events: none;
      }

      .hero-stack::after {
        content: "";
        position: absolute;
        inset: 12px;
        border-radius: var(--radius-md);
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.12), transparent);
      }

      .hero-visual {
        border-radius: var(--radius-lg);
        border: 1px solid rgba(255, 255, 255, 0.1);
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.06), transparent 60%),
          #0b0b0b;
        padding: 18px;
        min-height: 220px;
        display: grid;
        gap: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      }

      .hero-visual .mini-card {
        border-radius: var(--radius-md);
        border: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(18, 18, 18, 0.9);
        padding: 12px;
        display: grid;
        gap: 8px;
      }

      .mini-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        color: var(--muted);
      }

      .mini-bar {
        height: 6px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        overflow: hidden;
      }

      .mini-bar span {
        display: block;
        height: 100%;
        width: 55%;
        background: linear-gradient(90deg, rgba(255, 255, 255, 0.6), rgba(74, 124, 255, 0.6));
      }

      .brand {
        background: transparent;
        padding: 6px 0;
        border-radius: 14px;
        border: 0;
        box-shadow: none;
      }

      .brand h1 {
        margin: 0 0 8px;
        font-size: clamp(2.5rem, 4vw, var(--heading-72));
        letter-spacing: -0.03em;
      }

      .brand p {
        margin: 0;
        color: var(--muted);
        font-size: var(--copy-18);
        line-height: 1.5;
      }

      .card {
        background: #0b0b0b;
        border-radius: var(--radius-md);
        padding: 20px 24px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow:
          0 14px 30px rgba(0, 0, 0, 0.5),
          0 0 0 1px rgba(255, 255, 255, 0.02) inset;
      }

      .stack {
        display: grid;
        gap: 20px;
      }

      .grid {
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }

      .pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        color: #f7f7f7;
        font-size: 11px;
        font-weight: 600;
      }

      .pill-link {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #f7f7f7;
      }

      .section-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
      }

      .section-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
      }

      .section-cta span {
        transition: transform 0.2s ease;
      }

      .section-cta:hover span {
        transform: translateX(3px);
      }

      .auth-panel {
        background: #0b0b0b;
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 16px;
        border-radius: var(--radius-md);
        min-width: 220px;
        box-shadow: 0 14px 30px rgba(0, 0, 0, 0.5);
      }

      .auth-title {
        font-weight: 600;
        margin-bottom: 10px;
      }

      .auth-field {
        display: grid;
        gap: 6px;
        font-size: 12px;
        margin-bottom: 10px;
        color: var(--muted);
      }

      .auth-field input {
        padding: 8px 10px;
        border-radius: var(--radius-sm);
        border: 1px solid rgba(255, 255, 255, 0.12);
        font-family: inherit;
        background: rgba(255, 255, 255, 0.04);
        color: #f7f7f7;
      }

      .auth-field input:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.3);
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.1);
      }

      .auth-actions {
        display: flex;
        gap: 8px;
      }

      button {
        font-family: inherit;
        background: #f7f7f7;
        color: #111111;
        border: 1px solid #f7f7f7;
        border-radius: var(--radius-sm);
        padding: 8px 12px;
        cursor: pointer;
        font-weight: 600;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      button:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
      }

      button:focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.6);
        outline-offset: 2px;
      }

      button[data-auth-action="signup"] {
        background: transparent;
        color: #f7f7f7;
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      button[data-auth-action="signout"] {
        background: #f7f7f7;
        color: #111111;
        border: 1px solid #f7f7f7;
      }

      .auth-error {
        color: #b1281f;
        font-size: 12px;
        min-height: 16px;
      }

      .auth-user {
        font-size: 12px;
        color: var(--muted);
        margin-bottom: 10px;
        word-break: break-all;
      }

      .section-title {
        font-size: 22px;
        margin-bottom: 6px;
        letter-spacing: -0.01em;
      }

      .section-subtitle {
        color: var(--muted);
        margin: 0 0 16px;
        font-size: var(--copy-16);
      }

      .link-card {
        display: grid;
        gap: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: var(--radius-md);
        padding: 16px;
        background: rgba(10, 10, 10, 0.9);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .link-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 18px 36px rgba(0, 0, 0, 0.45);
      }

      .link-card:hover h3 {
        color: #ffffff;
      }

      .link-card h3 {
        margin: 0;
        font-size: 18px;
      }

      .link-card p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
      }

      .guide-content :global(h2) {
        margin-top: 24px;
      }

      .guide-content :global(h3) {
        margin-top: 18px;
      }

      @media (max-width: 720px) {
        .nav {
          flex-direction: column;
        }

        .auth-panel {
          width: 100%;
        }

        .nav-links {
          justify-content: center;
        }
      }

      footer {
        margin-top: 56px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        color: var(--muted);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 12px;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="nav">
        <div class="nav-links">
          <a href="/">Courses</a>
          <a href="/docs" class="pill pill-link">Docs</a>
          <a href="/deploy" class="pill pill-link">Deploy</a>
        </div>
        <AuthPanel />
      </header>

      <section class="hero">
        <div class="hero-stack" aria-hidden="true"></div>
        <div class="brand">
          <h1>Literature Course Library</h1>
          <p>Read, track, and reflect across a structured canon.</p>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="mini-card">
            <div class="mini-row">
              <span>Great Literature 101</span>
              <span>8/10</span>
            </div>
            <div class="mini-bar"><span></span></div>
          </div>
          <div class="mini-card">
            <div class="mini-row">
              <span>Great Literature 105</span>
              <span>3/10</span>
            </div>
            <div class="mini-bar"><span></span></div>
          </div>
          <div class="mini-card">
            <div class="mini-row">
              <span>Southern Gothic</span>
              <span>2/5</span>
            </div>
            <div class="mini-bar"><span></span></div>
          </div>
        </div>
      </section>

      <slot />

      <footer>
        <span>Literature Course Library</span>
        <span>Built with Astro + Supabase</span>
      </footer>
    </div>
  </body>
</html>
