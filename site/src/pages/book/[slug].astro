---
import Base from "../../layouts/Base.astro";
import StatusWidget from "../../components/StatusWidget.astro";
import { getCourses, getBookBySlug } from "../../lib/content.js";
import BookCover from "../../components/BookCover.astro";
import Spine from "../../components/Spine.astro";
import { shelfLooks } from "../../../public/scripts/book-look.js";
import { resolveSourceLabel } from "../../lib/source-labels.js";
import { slugify } from "../../lib/slug.js";
import {
  loadSystemBookBySlug,
  loadSystemBookGuides,
  loadSystemBooks,
  loadSystemCourseBooks,
  loadSystemCourses
} from "../../lib/system-content.js";

export const prerender = true;

export async function getStaticPaths() {
  const systemBooks = await loadSystemBooks();
  const books = systemBooks ?? getCourses().flatMap((course) => course.books);
  return books.map((book) => ({
    params: { slug: book.slug }
  }));
}

const { slug } = Astro.params;
const systemCourses = await loadSystemCourses();
const markdownCourses = getCourses();
const courses = systemCourses ?? markdownCourses;
const systemBook = await loadSystemBookBySlug(slug);
const markdownBook = getBookBySlug(slug);
const book = systemBook ?? markdownBook;
if (!book) {
  throw new Error(`Book not found: ${slug}`);
}
const bookSource = systemBook ? "supabase" : "markdown";
const bookSourceLabel = resolveSourceLabel(bookSource);

const systemGuides = await loadSystemBookGuides(book.id);

const markdownCourse = markdownCourses.find((c) => c.id === book.courseId) || null;
const course = courses.find((c) => c.id === book.courseId) || markdownCourse || {
  id: book.courseId,
  slug: book.courseId ? slugify(book.courseId) : "",
  title: "Course"
};
const systemCourseBooks = await loadSystemCourseBooks(book.courseId);
const courseBooks = systemCourseBooks ?? markdownCourse?.books ?? course.books ?? [];

const shelfBooks = courseBooks.some((entry) => entry.slug === book.slug) ? courseBooks : [];
const looks = shelfLooks(shelfBooks);
const bookLookIndex = shelfBooks.findIndex((entry) => entry.slug === book.slug);
const look = bookLookIndex >= 0 ? looks[bookLookIndex] : shelfLooks([book])[0];
const courseTitleParts = (course.title || "").split(" - ");
const courseDisplayTitle = course.courseType || courseTitleParts.slice(1).join(" - ") || course.title;

const guideCards =
  systemGuides ?? (markdownBook?.guides ?? []).filter((guide) => guide.module);
---
<Base
  title={`${book.title} | Literature Course Library`}
  authRequired={true}
  courseSwitcher={{
    current: course,
    courses
  }}
  bookSwitcher={{
    current: book,
    books: courseBooks
  }}
>
  <section class="stack">
    <div class="reading-desk">
      <BookCover
        class="book-cover--hero"
        title={book.title}
        author={book.author}
        coverUrl={book.coverUrl}
        look={look}
      />
      <div class="book-intro">
        <a class="back-link" href={`/course/${course.slug}#book-${book.slug}`}>Put it back on the shelf</a>
        <p class="eyebrow">{courseDisplayTitle}</p>
        <h1 class="section-title page-title">{book.title}</h1>
        {book.author ? <p class="book-author">{book.author}</p> : null}
        <span class="data-source-pill">{bookSourceLabel}</span>
        <StatusWidget bookId={book.id} />
      </div>
    </div>

    <div class="section-header">
      <div>
        <h2 class="section-title">Study Guides</h2>
        <p class="section-subtitle">One for before, one for alongside, one for after.</p>
      </div>
    </div>

    {guideCards.length ? (
      <div class="guide-grid">
        {guideCards.map((guide) => (
          <a
            class="guide-card"
            href={`/book/${book.slug}/${guide.slug}`}
            data-guide-type={guide.guideType || "other"}
          >
            <span class="guide-chip">{guide.stage}</span>
            <div class="guide-title">{guide.label}</div>
            <p class="guide-excerpt">
              {guide.excerpt || "Open for the full guide and prompts."}
            </p>
            <span class="guide-action">Open</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="card">
        <p>No study guides are available yet for this book.</p>
      </div>
    )}

    {shelfBooks.length > 1 ? (
      <>
        <div class="section-header">
          <div>
            <h2 class="section-title">The shelf it came from</h2>
            <p class="section-subtitle">
              <a class="text-link" href={`/course/${course.slug}`}>{courseDisplayTitle}</a>, with a gap where this one lives.
            </p>
          </div>
        </div>
        <div class="bookcase bookcase--mini">
          <div class="shelf">
            <div class="shelf-books">
              {shelfBooks.map((entry, index) => (
                <Spine
                  book={entry}
                  look={looks[index]}
                  href={`/book/${entry.slug}`}
                  current={entry.slug === book.slug}
                />
              ))}
            </div>
          </div>
        </div>
      </>
    ) : null}
  </section>
  <script type="module" src="/scripts/course-book-status.js"></script>
</Base>
