---
import Base from "../layouts/Base.astro";
import { getCourses } from "../lib/content.js";
import { slugify } from "../lib/slug.js";
import { createClient } from "@supabase/supabase-js";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

async function loadSystemCourses() {
  if (!supabaseUrl || !supabaseKey) return null;
  const supabase = createClient(supabaseUrl, supabaseKey, {
    auth: { persistSession: false }
  });

  const { data: courseRows, error: courseError } = await supabase
    .from("courses")
    .select("course_id, title, course_type, summary, slug")
    .eq("source", "system")
    .order("course_id");

  if (courseError || !courseRows || !courseRows.length) return null;

  const courseIds = courseRows.map((course) => course.course_id);

  const { data: bookRows, error: bookError } = await supabase
    .from("books")
    .select("course_id, cover_url")
    .in("course_id", courseIds);

  if (bookError) return null;

  const bookMap = new Map();
  (bookRows || []).forEach((book) => {
    if (!book?.course_id) return;
    const entries = bookMap.get(book.course_id) || [];
    entries.push({ coverUrl: book.cover_url || null });
    bookMap.set(book.course_id, entries);
  });

  return courseRows.map((course) => ({
    id: course.course_id,
    title: course.title,
    summary: course.summary || "",
    slug: course.slug || slugify(course.course_id),
    books: bookMap.get(course.course_id) || [],
    courseType: course.course_type || ""
  }));
}

const courses = (await loadSystemCourses()) ?? getCourses();
---
<Base title="Literature Course Library" authRequired={true}>
  <section class="stack">
    <div class="section-header">
      <div>
        <h2 class="section-title">Courses</h2>
        <p class="section-subtitle">Browse each course, track your reading, and rate completed books.</p>
      </div>
    </div>
    <div class="section-divider"></div>
    <div class="data-list">
      {courses.map((course) => {
        const titleParts = course.title.split(" - ");
        const courseType = course.courseType || titleParts.slice(1).join(" - ");
        const displayTitle = courseType || course.title;
        const summary = course.summary || "Short course overview available in the syllabus.";

        // Logic to pick 3 random books with covers for the fan
        const booksWithCovers = course.books.filter(b => b.coverUrl);
        // Shuffle and pick up to 3
        const recentBooks = booksWithCovers
           .sort(() => 0.5 - Math.random())
           .slice(0, 3);
           
        // Fallback if not enough covers, pick mostly ensuring we have at least one or use placeholders if needed
        // If 0 covers, we keep is-empty.
        
        return (
          <a
            class="data-row"
            href={`/course/${course.slug}`}
            data-course-row
            data-course-id={course.id}
            data-total-books={course.books.length}
            data-status="not_started"
          >
            <div class="data-body">
              <div class={`data-cover ${recentBooks.length > 0 ? "is-stack" : "is-empty"}`}>
                 {recentBooks.length > 0 ? (
                    recentBooks.map((book, i) => (
                      <div class="cover-stack-item">
                        <img src={book.coverUrl} alt="" loading="lazy" decoding="async" />
                      </div>
                    ))
                 ) : null}
              </div>
              <div class="data-main">
                <div class="data-title">{displayTitle}</div>
                <div class="data-sub">{summary}</div>
              </div>
            </div>
            <div class="data-meta">
              <span class="data-chip">{course.title}</span>
              <span class="status-pill" data-status-pill data-status="not_started">
                <span class="status-dot" aria-hidden="true"></span>
                <span class="status-label" data-status-label>Not started</span>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
  <script type="module" src="/scripts/course-list-status.js"></script>
  <script type="module" src="/scripts/course-list-user.js"></script>
</Base>
