{
  "name": "literature-course-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && node scripts/fetch-covers.mjs --auto && node scripts/sync-content-to-supabase.mjs --auto && node scripts/verify-supabase-content.mjs --auto && astro build && node scripts/patch-vercel-runtime.mjs",
    "validate": "node scripts/validate-content.mjs",
    "covers": "node scripts/fetch-covers.mjs",
    "sync:content": "node scripts/sync-content-to-supabase.mjs",
    "verify:content": "node scripts/verify-supabase-content.mjs",
    "preview": "astro preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^2.0.0-beta.85",
    "@astrojs/vercel": "^7.8.2",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@supabase/supabase-js": "^2.46.1",
    "ai": "^6.0.0-beta.159",
    "astro": "^4.15.4",
    "marked": "^12.0.2",
    "sanitize-html": "^2.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
