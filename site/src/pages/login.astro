---
import Base from "../layouts/Base.astro";
import AuthPanel from "../components/AuthPanel.astro";
---
<Base title="Sign in | Literature Course Library" showNav={false} showHero={false} showAuth={false} loginPage={true}>
  <section class="login-shell">
    <div class="login-card">
      <div class="login-brand">
        <h1>Sign in to keep your place.</h1>
        <p>Progress and scores stay with your account, ready when you come back.</p>
      </div>
      <div class="login-panel">
        <AuthPanel />
      </div>
    </div>
  </section>

</Base>
