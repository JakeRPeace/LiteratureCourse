---
const { bookId, initialStatus = "not_started", initialScore = "" } = Astro.props;
---
<div class="library-card" data-book-status data-book-id={bookId}>
  <div class="library-card-head">
    <span class="library-card-title">Reader's card</span>
    <span class="library-card-sub">Mark your place, and score it once you finish.</span>
  </div>
  <div class="status-grid">
    <label class="status-field">
      <span class="field-label">Status</span>
      <div class="select-wrap">
        <select data-status>
          <option value="not_started">Not started</option>
          <option value="in_progress">In progress</option>
          <option value="read">Read</option>
        </select>
        <span class="select-caret" aria-hidden="true"></span>
      </div>
    </label>
    <label class="status-field score-field">
      <span class="field-label">
        <span>Score</span>
        <output class="score-value" data-score-value>--</output>
      </span>
      <div class="score-control">
        <input
          type="range"
          min="0"
          max="5"
          step="0.25"
          value="0"
          data-score
          aria-label="Score"
        />
        <button type="button" class="score-clear" data-score-clear>Clear</button>
      </div>
      <div class="score-scale" aria-hidden="true">
        <span>0</span>
        <span>2.5</span>
        <span>5</span>
      </div>
    </label>
  </div>
  <div class="status-note" data-note></div>
</div>

<script type="module" src="/scripts/book-status.js"></script>

