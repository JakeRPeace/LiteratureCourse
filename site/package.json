{
  "name": "literature-course-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate && node scripts/fetch-covers.mjs --auto && node scripts/sync-content-to-supabase.mjs --auto && node scripts/verify-supabase-content.mjs --auto && astro build",
    "validate": "node scripts/validate-content.mjs",
    "covers": "node scripts/fetch-covers.mjs",
    "sync:content": "node scripts/sync-content-to-supabase.mjs",
    "verify:content": "node scripts/verify-supabase-content.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/vercel": "^7.8.2",
    "@ai-sdk/gateway": "^2.0.0-beta.85",
    "@supabase/supabase-js": "^2.46.1",
    "ai": "^6.0.0-beta.159",
    "astro": "^4.15.4",
    "marked": "^12.0.2",
    "zod": "^3.25.76"
  }
}
