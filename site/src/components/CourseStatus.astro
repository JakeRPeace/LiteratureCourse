---
const { bookIds } = Astro.props;
---
<div class="card" data-course-status data-book-ids={JSON.stringify(bookIds)}>
  <div class="section-title">Course status</div>
  <p class="section-subtitle" data-course-status-label>Sign in to see status.</p>
</div>

<script type="module" src={Astro.resolve("../scripts/course-status.js")}></script>
