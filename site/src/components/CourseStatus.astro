---
const { bookIds } = Astro.props;
---
<div class="course-status-header" data-course-status data-book-ids={JSON.stringify(bookIds)} data-status="signed_out">
  <div class="status-top">
    <div class="status-info">
      <p class="eyebrow">Your place in this course</p>
      <h2 class="status-title" data-course-status-label>Sign in to see your place</h2>
    </div>
    <div class="status-badge">
       <span class="status-pill" data-status-pill data-status="signed_out">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="status-label" data-status-label>Locked</span>
      </span>
    </div>
  </div>
  
  <div class="status-progress-container">
    <div class="status-progress-bar">
      <div class="status-progress-fill" data-progress-fill style="width: 0%"></div>
    </div>
    <div class="status-stats" data-status-stats>
      No data available
    </div>
  </div>
</div>

<script type="module" src="/scripts/course-status.js"></script>

