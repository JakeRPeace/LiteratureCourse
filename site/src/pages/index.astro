---
import Base from "../layouts/Base.astro";
import { getCourses } from "../lib/content.js";

const courses = getCourses();
---
<Base title="Literature Course Library" authRequired={true}>
  <section class="stack">
    <div class="section-header">
      <div>
        <h2 class="section-title">Courses</h2>
        <p class="section-subtitle">Browse each course, track your reading, and rate completed books.</p>
      </div>
      <a class="section-cta" href="/">
        View all <span>-&gt;</span>
      </a>
    </div>
    <div class="section-divider"></div>
    <div class="grid">
      {courses.map((course) => (
        <a class="link-card course-card" href={`/course/${course.slug}`}>
          <div class="course-head">
            <span class="pill">{course.books.length} books</span>
            <span class="course-tag">{course.id}</span>
          </div>
          <div class="course-meta">
            <h3>{course.title}</h3>
            <p>Structured reading plan with study guides and notes.</p>
          </div>
          <div class="course-foot">
            <span>Explore course</span>
            <span class="course-link">Open <span>-&gt;</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
