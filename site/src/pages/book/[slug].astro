---
import Base from "../../layouts/Base.astro";
import StatusWidget from "../../components/StatusWidget.astro";
import { getCourses, getBookBySlug } from "../../lib/content.js";

export function getStaticPaths() {
  const books = getCourses().flatMap((course) => course.books);
  return books.map((book) => ({
    params: { slug: book.slug }
  }));
}

const { slug } = Astro.params;
const book = getBookBySlug(slug);
if (!book) {
  throw new Error(`Book not found: ${slug}`);
}

const courses = getCourses();
const course = courses.find((c) => c.id === book.courseId);

const guideCards = book.guides.filter((guide) => guide.module);
---
<Base
  title={`${book.title} | Literature Course Library`}
  authRequired={true}
  courseSwitcher={{
    current: course,
    courses
  }}
  bookSwitcher={{
    current: book,
    books: course.books
  }}
>
  <section class="stack">
    <div>
      <a class="pill" href={`/course/${course.slug}`}>Back to course</a>
    </div>
    <div class="book-hero">
      <div class={`book-cover ${book.coverUrl ? "" : "is-empty"}`}>
        {book.coverUrl ? (
          <img
            src={book.coverUrl}
            alt={`Cover of ${book.title}`}
            loading="lazy"
            decoding="async"
          />
        ) : null}
      </div>
      <div class="book-intro">
        <h2 class="section-title">{book.title}</h2>
        <p class="section-subtitle">
          {book.author ? `${book.author} · ` : ""}{book.id}
        </p>
      </div>
    </div>

    <div class="section-divider"></div>

    <StatusWidget bookId={book.id} />

    <div class="section-header">
      <div>
        <h3 class="section-title">Study Guides</h3>
        <p class="section-subtitle">Explore the reading flow without drowning in full text.</p>
      </div>
    </div>

    <div class="section-divider"></div>

    {guideCards.length ? (
      <div class="guide-grid">
        {guideCards.map((guide) => (
          <a
            class="card guide-card"
            href={`/book/${book.slug}/${guide.slug}`}
            data-guide-type={guide.guideType || "other"}
          >
            <div class="guide-card-top">
              <span class="guide-kicker">{guide.stage}</span>
              <span class="guide-action">Open -&gt;</span>
            </div>
            <div class="guide-title">{guide.label}</div>
            <p class="guide-excerpt">
              {guide.excerpt || "Open for the full guide and prompts."}
            </p>
            <div class="guide-meta">
              {guide.order ? <span class="guide-chip">Guide {guide.order}</span> : null}
              <span class="guide-chip">{book.id}</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="card">
        <p>No study guides are available yet for this book.</p>
      </div>
    )}
  </section>
</Base>

<style>
  .book-hero {
    display: grid;
    grid-template-columns: minmax(160px, 220px) 1fr;
    gap: 24px;
    align-items: center;
  }

  .book-intro {
    display: grid;
    gap: 10px;
  }

  .book-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    overflow: hidden;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    box-shadow: 0 18px 34px rgba(0, 0, 0, 0.6);
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book-cover.is-empty::after {
    content: "";
    position: absolute;
    inset: 12px;
    border-radius: 12px;
    border: 1px dashed rgba(255, 255, 255, 0.2);
  }

  .guide-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .guide-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 220px;
    border-color: rgba(255, 255, 255, 0.12);
    background: linear-gradient(135deg, rgba(16, 16, 16, 0.92), rgba(6, 6, 6, 0.94));
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    --guide-accent: rgba(120, 120, 120, 0.25);
  }

  .guide-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at top right, var(--guide-accent), transparent 60%);
    opacity: 0.85;
    pointer-events: none;
  }

  .guide-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.55);
  }

  .guide-card[data-guide-type="pre_reading"] {
    --guide-accent: rgba(120, 200, 255, 0.35);
  }

  .guide-card[data-guide-type="notes"] {
    --guide-accent: rgba(255, 190, 120, 0.35);
  }

  .guide-card[data-guide-type="post_reading"] {
    --guide-accent: rgba(120, 240, 180, 0.35);
  }

  .guide-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .guide-kicker {
    position: relative;
    z-index: 1;
  }

  .guide-action {
    position: relative;
    z-index: 1;
    font-weight: 600;
  }

  .guide-title {
    position: relative;
    z-index: 1;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .guide-excerpt {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .guide-meta {
    position: relative;
    z-index: 1;
    margin-top: auto;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .guide-chip {
    font-size: 11px;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #f0f0f0;
    background: rgba(10, 10, 10, 0.6);
  }

  @media (max-width: 720px) {
    .book-hero {
      grid-template-columns: 1fr;
    }

    .book-cover {
      max-width: 220px;
    }
  }
</style>
