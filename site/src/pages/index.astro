---
import Base from "../layouts/Base.astro";
import Spine from "../components/Spine.astro";
import { getCourses } from "../lib/content.js";
import { resolveSourceLabel } from "../lib/source-labels.js";
import { loadSystemCourses } from "../lib/system-content.js";
import { shelfLooks } from "../../public/scripts/book-look.js";

const systemCourses = await loadSystemCourses();
const courses = systemCourses ?? getCourses();
const systemCourseSource = systemCourses ? "supabase" : "markdown";
const sourceLabel = resolveSourceLabel(systemCourseSource);
---
<Base title="Literature Course Library" authRequired={true}>
  <section class="storefront">
    <div class="brand">
      <h1>Literature Course Library</h1>
      <p>Pull a book from the shelf, read the guide, and keep your place.</p>
    </div>
    <aside class="reading-table" data-reading-table aria-labelledby="reading-table-title">
      <h2 class="table-title" id="reading-table-title">On your reading table</h2>
      <div class="table-books" data-table-books hidden></div>
      <p class="table-empty" data-table-empty>Finding your place…</p>
    </aside>
  </section>

  <section class="bookcase" aria-label="Courses" data-course-list>
    {courses.map((course) => {
      const titleParts = course.title.split(" - ");
      const courseType = course.courseType || titleParts.slice(1).join(" - ");
      const displayTitle = courseType || course.title;
      const courseNumber = (course.title.match(/\b(\d{3})\b/) || [])[1] || "";
      const summary = course.summary || "Short course overview available in the syllabus.";
      const books = course.books.filter((book) => book && book.title);
      const looks = shelfLooks(books);
      const total = course.books.length;

      return (
        <article
          class="shelf"
          id={`course-${course.slug}`}
          data-course-row
          data-course-id={course.id}
          data-total-books={total}
          data-status="not_started"
          data-course-source={systemCourseSource}
        >
          <header class="shelf-head">
            <a class="shelf-plate" href={`/course/${course.slug}`}>
              {courseNumber ? <span class="shelf-number">{courseNumber}</span> : null}
              <h2 class="shelf-title">{displayTitle}</h2>
            </a>
            <p class="shelf-summary">{summary}</p>
            <div class="shelf-meta">
              <span class="data-source-pill">{sourceLabel}</span>
              <span class="shelf-count" data-shelf-count>
                {total} {total === 1 ? "book" : "books"}
              </span>
              <span class="status-pill" data-status-pill data-status="not_started">
                <span class="status-dot" aria-hidden="true"></span>
                <span class="status-label" data-status-label>Not started</span>
              </span>
            </div>
          </header>
          <div class="shelf-books">
            {books.map((book, index) => (
              <Spine book={book} look={looks[index]} href={`/book/${book.slug}`} source={systemCourseSource} />
            ))}
            <a class="shelf-card" href={`/course/${course.slug}`}>
              <span class="shelf-card-eyebrow">{courseNumber ? `Course ${courseNumber}` : "Course"}</span>
              <span class="shelf-card-title">Syllabus &amp; reading order</span>
              <span class="shelf-card-action">Open the course</span>
            </a>
          </div>
        </article>
      );
    })}
  </section>

  <section class="counter" data-course-chat-panel hidden>
    <div>
      <h2 class="counter-title">Ask at the counter</h2>
      <p class="counter-copy">Describe the course you have in mind and we will pull three books for it.</p>
      <p class="counter-note" data-course-chat-note></p>
    </div>
    <button type="button" data-course-chat-open>Open course creator</button>
  </section>

  <dialog class="chat-modal" data-course-chat-modal>
    <div class="chat-modal-frame">
      <div class="chat-header">
        <div>
          <div class="chat-title">Course Creator</div>
          <div class="chat-subtitle">Describe the course you want. We will draft a 3-book outline.</div>
        </div>
        <button type="button" class="chat-close" data-course-chat-close>Close</button>
      </div>
      <div class="chat-log" data-course-chat-log></div>
      <div class="chat-actions">
        <button type="button" class="chat-secondary" data-course-chat-clear>Clear</button>
        <button type="button" class="chat-primary" data-course-chat-create disabled>Create course</button>
      </div>
      <form class="chat-input" data-course-chat-form>
        <textarea
          name="course-chat"
          rows="3"
          placeholder="Example: Build a Modern Literature course focused on identity and exile."
          data-course-chat-input
          required
        ></textarea>
        <button type="submit" data-course-chat-send>Send</button>
      </form>
      <div class="chat-note" data-course-chat-modal-note></div>
    </div>
  </dialog>
  <script type="module" src="/scripts/course-list-status.js"></script>
  <script type="module" src="/scripts/course-list-user.js"></script>
  <script type="module" src="/scripts/course-chat-entry.js"></script>
</Base>
