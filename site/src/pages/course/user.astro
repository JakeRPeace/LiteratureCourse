---
import Base from "../../layouts/Base.astro";
import { getCourses } from "../../lib/content.js";

const courseSwitcher = {
  current: {
    title: "Loading course...",
    id: "",
    slug: "",
    source: "user"
  },
  courses: getCourses()
};
---
<Base title="Course | Literature Course Library" authRequired={true} courseSwitcher={courseSwitcher}>
  <section class="stack" data-user-course>
    <div>
      <a class="pill" href="/">Back to courses</a>
      <h2 class="section-title" data-user-course-title>Loading course...</h2>
      <p class="section-subtitle" data-user-course-id></p>
      <span class="data-source-pill">User</span>
    </div>

    <div class="section-divider"></div>
    <div class="card" data-user-course-error hidden>
      <p></p>
    </div>

    <div class="section-header">
      <div>
        <h3 class="section-title">Course Materials</h3>
        <p class="section-subtitle">Scan the overview and syllabus before diving in.</p>
      </div>
    </div>

    <div class="section-divider"></div>

    <div class="course-doc-grid" data-user-course-docs></div>
    <div class="card" data-user-course-docs-empty hidden>
      <p>No course documents are available yet.</p>
    </div>

    <div class="card">
      <h3>Books</h3>
      <div class="data-list" data-user-course-books></div>
      <div data-user-course-books-empty hidden>
        <p>No books are available yet.</p>
      </div>
    </div>
  </section>
  <script type="module" src="/scripts/user-course-page.js"></script>
  <script type="module" src="/scripts/course-book-status.js"></script>
</Base>

<style>
  .course-doc-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .course-doc-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 220px;
    border-color: rgba(255, 255, 255, 0.12);
    background: linear-gradient(135deg, rgba(16, 16, 16, 0.92), rgba(6, 6, 6, 0.94));
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    --doc-accent: rgba(120, 120, 120, 0.25);
  }

  .course-doc-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at top right, var(--doc-accent), transparent 60%);
    opacity: 0.85;
    pointer-events: none;
  }

  .course-doc-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.55);
  }

  .course-doc-card[data-doc-type="readme"] {
    --doc-accent: rgba(120, 200, 255, 0.35);
  }

  .course-doc-card[data-doc-type="syllabus"] {
    --doc-accent: rgba(255, 190, 120, 0.35);
  }

  .course-doc-card[data-doc-type="index"] {
    --doc-accent: rgba(120, 240, 180, 0.35);
  }

  .course-doc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  .course-doc-kicker {
    position: relative;
    z-index: 1;
  }

  .course-doc-action {
    position: relative;
    z-index: 1;
    font-weight: 600;
  }

  .course-doc-title {
    position: relative;
    z-index: 1;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .course-doc-excerpt {
    position: relative;
    z-index: 1;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .course-doc-meta {
    position: relative;
    z-index: 1;
    margin-top: auto;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .course-doc-chip {
    font-size: 11px;
    color: var(--muted);
    border: 1px solid rgba(255, 255, 255, 0.16);
    padding: 4px 8px;
    border-radius: 999px;
  }
</style>
